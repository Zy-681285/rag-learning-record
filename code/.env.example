# RAG系统环境变量配置
# 复制此文件为 .env 并填入你的实际值

# ============== 必需配置 ==============
# SiliconFlow API密钥（必需）
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key-here

# LLM模型配置
LLM_MODEL=THUDM/GLM-4-9B-0414
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=200

# ============== 嵌入模型配置 ==============
# 嵌入模型（推荐BAAI/bge-large-zh-v1.5）
EMBED_MODEL=BAAI/bge-large-zh-v1.5
# 嵌入方式：api（通过 SiliconFlow API）或 local（使用 HuggingFace 本地模型）
# api：模型需在 SiliconFlow 上可用，无需额外安装
# local：需安装 sentence-transformers，模型从 HuggingFace 下载
EMBED_MODE=api

# 重排序模型（可选，需要USE_RERANK=true）
RERANK_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANK=false

# ============== 向量数据库配置 ==============
# ChromaDB路径
VECTOR_DB_PATH=./vector_db
COLLECTION_NAME=langchain_collection

# 文档分割配置
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVAL_K=3

# ============== 性能配置 ==============
# 线程池大小（4核8GB推荐2）
MAX_WORKERS=2

# 缓存配置（秒）
CACHE_TTL=300

# 查询超时（秒）
QUERY_TIMEOUT=60

# ============== 服务配置 ==============
# API服务配置
API_HOST=0.0.0.0
API_PORT=8000
DEBUG_MODE=false

# 日志配置
LOG_LEVEL=INFO

# ============== 路径配置 ==============
# 知识库文档路径
DATA_DIR=./data

# 日志路径
LOG_DIR=./logs

# ============== 可选配置 ==============
# 钉钉机器人配置（如果需要）
DINGTALK_APP_KEY=your-dingtalk-app-key
DINGTALK_APP_SECRET=your-dingtalk-app-secret

# 备用LLM模型（当主模型不可用时）
BACKUP_LLM_MODEL=Qwen/Qwen2.5-7B

# 嵌入批量大小（用于构建向量库）
EMBED_BATCH_SIZE=100

# ============== 高级配置 ==============
# 是否启用异步模式
ASYNC_MODE=true

# 重试次数
MAX_RETRIES=3

# 重试延迟（秒）
RETRY_DELAY=1

# 连接超时（秒）
CONNECT_TIMEOUT=30

# 读取超时（秒）
READ_TIMEOUT=60

# ============== 提示词配置 ==============
# 自定义系统提示词
SYSTEM_PROMPT=你是一个专业的客服助手，请根据知识库内容回答用户问题，要求回答简洁（100-200字）。

# 用户提示词模板
USER_PROMPT_TEMPLATE=根据以下上下文信息回答用户问题：

上下文信息：
{context}

用户问题：{question}

回答：

# ============== 示例配置 ==============
# 完整的.env文件示例：
# 
# SILICONFLOW_API_KEY=sk-abc123def456ghi789jkl012mno345pqr678stu901vwx234yz
# LLM_MODEL=THUDM/GLM-4-9B-0414
# EMBED_MODEL=BAAI/bge-large-zh-v1.5
# VECTOR_DB_PATH=./vector_db
# API_PORT=8000
# 
# 保存后运行：
# 1. python build_vectors.py --force  # 构建向量库
# 2. python api.py                    # 启动API服务
# 3. python workflow_langchain.py "测试问题"  # 测试查询